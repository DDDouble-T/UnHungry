<view class="app-shell" bindtap="dismissFoodSuggestions">
  <view class="safe-top"></view>
  <view class="topbar">
    <text class="brand-name">干饭暂缓局</text>
  </view>

  <scroll-view class="page-scroll" style="{{pageScrollStyle}}" scroll-y enhanced show-scrollbar="false" scroll-into-view="{{activeTab == 'apply' || activeTab == 'record' ? formFocusAnchor : shareAnchor}}">
    <block wx:if="{{activeTab == 'square'}}">
      <view class="welcome-row"><text class="page-title">想吃先提交，判官帮你踩刹车</text></view>
      <view wx:if="{{!loading && !apiError}}" class="daily-card {{quotaExceeded ? 'daily-over' : ''}}">
        <view class="daily-main"><view class="daily-copy"><view class="card-kicker"><view class="pulse-dot"></view><text>今日热量额度</text></view><view class="daily-numbers"><text class="daily-number">{{todayCalories}}</text><text class="daily-unit">/ {{quotaAvailable ? calorieQuota : '未设置'}}<text wx:if="{{quotaAvailable}}"> kcal</text></text></view><text class="daily-hint">{{!quotaAvailable ? '设置额度后查看进度' : quotaExceeded ? '今日已超 ' + quotaExcess + ' kcal' : quotaRemaining == 0 ? '今日额度已用完' : '今日还剩 ' + quotaRemaining + ' kcal'}}</text></view>
          <view class="quota-ring" aria-label="{{quotaAvailable ? '已使用今日额度的 ' + quotaPercent + '%' : '尚未设置今日额度'}}"><view wx:if="{{quotaExceeded}}" class="quota-ring-overflow" style="{{quotaOverflowStyle}}"></view><view class="quota-ring-track" style="{{quotaRingStyle}}"><view class="quota-ring-center"><text class="ring-value">{{quotaAvailable ? quotaPercent + '%' : '—'}}</text><text class="ring-caption">{{quotaExceeded ? '已超额度' : '已用额度'}}</text></view></view></view>
        </view><text wx:if="{{quotaExceeded}}" class="daily-warning">管住嘴，先过审批</text>
      </view>
      <view class="section-head"><view><text class="section-title">审批广场</text><text class="section-note">帮别人踩一下刹车</text></view></view>
      <scroll-view wx:if="{{!loading && !apiError}}" class="filter-scroll" scroll-x="true" show-scrollbar="false"><view class="filter-list">
        <view class="filter-item {{activeFilter == 'all' ? 'is-active' : ''}}" data-filter="all" bindtap="switchFilter">全部</view><view class="filter-item {{activeFilter == 'pending' ? 'is-active' : ''}}" data-filter="pending" bindtap="switchFilter">待审批</view><view class="filter-item {{activeFilter == 'approved' ? 'is-active' : ''}}" data-filter="approved" bindtap="switchFilter">已放行</view><view class="filter-item {{activeFilter == 'rejected' ? 'is-active' : ''}}" data-filter="rejected" bindtap="switchFilter">暂缓驳回</view>
      </view></scroll-view>
      <view class="approval-list"><block wx:for="{{filteredApprovals}}" wx:key="id" wx:for-item="item">
        <view id="approval-{{item.id}}" class="approval-card {{shareTargetId == item.id ? 'share-selected' : ''}}">
          <view class="approval-head"><view class="approval-title-row"><text class="approval-title">{{item.title}}</text><text class="approval-calorie">{{item.calorie}}{{item.calorie == '待估算' ? '' : ' kcal'}}</text></view><view class="status-pill status-{{item.status}}"><image wx:if="{{item.status == 'pending'}}" class="status-icon" src="/assets/scales.svg" mode="aspectFit" aria-hidden="true"></image><text>{{item.statusLabel}}</text></view></view>
          <view class="approval-meta"><image wx:if="{{item.authorAvatar}}" class="author-avatar" src="{{item.authorAvatar}}" mode="aspectFill"></image><text class="approval-author">{{item.authorName}}</text><text class="meta-separator">·</text><text>{{item.time}}</text><text wx:if="{{item.isMine}}" class="own-label">· 我的申请</text></view>
          <view wx:if="{{item.price}}" class="approval-facts"><text class="approval-price">¥{{item.price}}</text></view><image wx:if="{{item.image}}" class="approval-image" src="{{item.image}}" mode="aspectFill"></image>
          <text class="reason-text">{{item.reason}}</text>
          <view wx:if="{{item.messages.length}}" class="approval-message {{item.messageExpanded ? 'approval-message-expanded' : ''}}">
            <view wx:if="{{item.messageExpanded}}" class="approval-message-list"><text wx:for="{{item.messages}}" wx:key="*this" wx:for-item="message" class="approval-message-text">{{message}}</text></view>
            <text wx:else class="approval-message-text">{{item.messages[0]}}</text>
            <button wx:if="{{item.messageNeedsExpand && !item.messageExpanded}}" class="approval-message-expand" data-id="{{item.id}}" bindtap="toggleApprovalMessages">展开</button>
          </view>
          <view wx:if="{{item.alternative}}" class="alternative-row"><text class="alternative-label">备选：</text><text class="alternative-text">{{item.alternative}}</text></view><view wx:if="{{item.intake}}" class="intake-row"><text>今日饮食：</text><text>{{item.intake}}</text></view>
          <view class="vote-battle">
            <view class="vote-battle-labels"><text class="vote-battle-wait">先等等 {{item.against}} 票</text><text class="vote-battle-versus">{{item.totalVotes ? 'VS' : '等待首票'}}</text><text class="vote-battle-approve">批准吃吧 {{item.support}} 票</text></view>
            <view class="vote-battle-bar {{!item.totalVotes || (item.supportRate > 0 && item.supportRate < 100) ? 'has-split' : ''}}" aria-label="{{'先等等 ' + item.against + ' 票，批准吃吧 ' + item.support + ' 票'}}"><view class="vote-battle-segment vote-battle-wait-fill" style="width: {{item.totalVotes ? 100 - item.supportRate : 50}}%;"></view><view class="vote-battle-segment vote-battle-approve-fill" style="width: {{item.totalVotes ? item.supportRate : 50}}%;"></view></view>
          </view>
          <view class="approval-footer"><text class="vote-summary">{{item.totalVotes ? item.totalVotes + ' 人投票 · ' + item.supportRate + '% 支持' : '等待第一张投票'}}</text><button class="share-button" data-id="{{item.id}}" bindtap="openShareSheet"><view class="share-mark" aria-hidden="true"></view><text>分享</text></button></view>
          <text wx:if="{{item.foodResult}}" class="food-result food-result-{{item.foodResult}}">{{item.foodResult == 'eaten' ? '吃了' : '没吃'}}</text>
          <view wx:elif="{{!item.foodDecided && item.status == 'pending' && !item.isMine}}" class="vote-actions"><button class="vote-button wait-button" data-id="{{item.id}}" data-choice="wait" bindtap="openVote"><text>先等等</text><text class="button-mark">×</text></button><button class="vote-button approve-button" data-id="{{item.id}}" data-choice="approve" bindtap="openVote"><text>批准吃吧</text><text class="button-mark">✓</text></button></view>
        </view>
      </block><view wx:if="{{loading}}" class="empty-state"><text>正在加载数据…</text></view><view wx:elif="{{apiError}}" class="empty-state"><text>{{apiError}}</text><text class="section-link" bindtap="retryLoadData">点击重试</text></view><view wx:elif="{{filteredApprovals.length == 0}}" class="empty-state"><text class="empty-icon">⌁</text><text>这个筛选下还没有审批单</text></view></view>
      <view class="bottom-space"></view>
    </block>

    <block wx:if="{{activeTab == 'apply'}}">
      <view class="page-heading"><text class="eyebrow">MAKE A PAUSE</text><text class="page-title">发起一张审批单</text><text class="page-subtitle">把想吃的写下来，让大家帮你看一眼。</text></view>
      <view class="form-card"><view class="form-section-title"><text>先说说这顿</text><text class="required-note">* 必填</text></view>
        <view class="field-row two-columns"><view id="form-field-foodName" class="field-block" catchtap="stopPropagation"><text class="field-label">食物名称 <text>*</text></text><input class="field-input" value="{{form.foodName}}" data-field="foodName" bindfocus="onFormFocus" bindinput="onFormInput" adjust-position="false" placeholder="比如：炸鸡" maxlength="30" /><view wx:if="{{foodSuggestions.length}}" class="food-suggestions"><view wx:for="{{foodSuggestions}}" wx:key="id" wx:for-item="item" class="food-suggestion" data-id="{{item.id}}" bindtap="selectFood"><text class="food-suggestion-name">{{item.name}}</text><text class="food-suggestion-range">{{item.rangeLabel}}</text></view></view><view wx:elif="{{foodMatchHint}}" class="food-match-hint"><text>{{foodMatchHint}}</text></view></view><view id="form-field-price" class="field-block"><text class="field-label">价格 <text class="optional-note">选填</text></text><view class="input-with-unit"><text>¥</text><input class="field-input" type="digit" value="{{form.price}}" data-field="price" bindfocus="onFormFocus" bindinput="onFormInput" adjust-position="false" placeholder="0.00" /></view></view></view>
        <view wx:if="{{selectedFoodId}}" id="form-field-portion" class="field-block"><text class="field-label">分量</text><picker mode="selector" range="{{portionOptions}}" value="{{portionIndex}}" bindchange="onPortionChange"><view class="portion-picker"><text>{{portionOptions[portionIndex]}}</text><text class="portion-arrow">⌄</text></view></picker></view>
        <view id="form-field-calorie" class="field-block"><text class="field-label">估算热量 <text class="optional-note">可手动修改</text></text><view class="input-with-unit"><input class="field-input" type="digit" value="{{form.calorie}}" data-field="calorie" bindfocus="onFormFocus" bindinput="onFormInput" adjust-position="false" placeholder="大约多少 kcal" /><text>kcal</text></view><view wx:if="{{calorieHint}}" class="calorie-hint"><text>{{calorieHint}}</text><text>{{calorieSource == 'server' ? '已填入推荐值' : '已手动修改'}}</text></view></view>
        <view id="form-field-reason" class="field-block"><text class="field-label">为什么想吃 <text>*</text></text><textarea class="field-textarea" value="{{form.reason}}" data-field="reason" bindfocus="onFormFocus" bindinput="onFormInput" adjust-position="false" placeholder="是饿了、馋了，还是今天值得奖励？" maxlength="100" auto-height="true"></textarea></view>
        <view id="form-field-alternative" class="field-block"><text class="field-label">更健康的替代方案 <text class="optional-note">选填</text></text><input class="field-input" value="{{form.alternative}}" data-field="alternative" bindfocus="onFormFocus" bindinput="onFormInput" adjust-position="false" placeholder="比如：无糖酸奶 + 香蕉" maxlength="50" /></view>
        <view id="form-field-intake" class="field-block"><text class="field-label">今天已经吃了什么</text><input class="field-input" value="{{form.intake}}" data-field="intake" bindfocus="onFormFocus" bindinput="onFormInput" adjust-position="false" placeholder="选填，让大家判断更准确" maxlength="60" /></view>
        <view class="photo-field" bindtap="chooseImage"><view class="photo-placeholder" wx:if="{{!uploadedImage}}"><text class="photo-plus">＋</text><text>添加食物照片</text></view><image wx:else class="photo-preview" src="{{uploadedImage}}" mode="aspectFill"></image></view>
        <view class="form-footnote"><text class="footnote-mark">i</text><text>投票必须写理由才会生效。</text></view>
        <view class="approval-identity"><checkbox-group bindchange="onAnonymousChange"><label class="anonymous-option"><checkbox class="anonymous-checkbox" value="anonymous" checked="{{form.isAnonymous}}" aria-label="匿名发布" /><view class="anonymous-circle {{form.isAnonymous ? 'is-checked' : ''}}" aria-hidden="true"><text wx:if="{{form.isAnonymous}}">✓</text></view><text>匿名发布</text></label></checkbox-group></view>
        <view class="form-actions"><button class="quiet-button" bindtap="resetForm">清空</button><button class="primary-button" bindtap="submitApproval">发出审批单 <text>→</text></button></view>
      </view><view class="bottom-space"></view>
    </block>

    <block wx:if="{{activeTab == 'record'}}">
      <view class="page-heading"><text class="eyebrow">TODAY'S FOOD LOG</text><text class="page-title">添加今日已吃食物</text><text class="page-subtitle">只记录到我的饮食，不会发起审批。</text></view>
      <view class="form-card"><view class="form-section-title"><text>记下这一顿</text><text class="required-note">热量可选</text></view>
        <view id="form-field-foodName" class="field-block" catchtap="stopPropagation"><text class="field-label">食物名称 <text>*</text></text><input class="field-input" value="{{form.foodName}}" data-field="foodName" bindfocus="onFormFocus" bindinput="onFormInput" adjust-position="false" placeholder="比如：鸡蛋、米饭" maxlength="30" /><view wx:if="{{foodSuggestions.length}}" class="food-suggestions"><view wx:for="{{foodSuggestions}}" wx:key="id" wx:for-item="item" class="food-suggestion" data-id="{{item.id}}" bindtap="selectFood"><text class="food-suggestion-name">{{item.name}}</text><text class="food-suggestion-range">{{item.rangeLabel}}</text></view></view><view wx:elif="{{foodMatchHint}}" class="food-match-hint"><text>{{foodMatchHint}}</text></view></view>
        <view wx:if="{{selectedFoodId}}" id="form-field-portion" class="field-block"><text class="field-label">分量</text><picker mode="selector" range="{{portionOptions}}" value="{{portionIndex}}" bindchange="onPortionChange"><view class="portion-picker"><text>{{portionOptions[portionIndex]}}</text><text class="portion-arrow">⌄</text></view></picker></view>
        <view id="form-field-calorie" class="field-block"><text class="field-label">热量 <text class="optional-note">可选</text></text><view class="input-with-unit"><input class="field-input" type="digit" value="{{form.calorie}}" data-field="calorie" bindfocus="onFormFocus" bindinput="onFormInput" adjust-position="false" placeholder="大约多少 kcal" /><text>kcal</text></view><view wx:if="{{calorieHint}}" class="calorie-hint"><text>{{calorieHint}}</text><text>{{calorieSource == 'server' ? '已填入推荐值' : '已手动修改'}}</text></view></view>
        <view class="photo-field" bindtap="chooseImage"><view class="photo-placeholder" wx:if="{{!uploadedImage}}"><text class="photo-plus">＋</text><text>添加食物照片</text></view><image wx:else class="photo-preview" src="{{uploadedImage}}" mode="aspectFill"></image></view>
        <view class="form-footnote"><text class="footnote-mark">i</text><text>这条记录只会出现在“我的”，不会进入审批广场。</text></view><view class="form-actions"><button class="quiet-button" bindtap="switchTab" data-tab="me">取消</button><button class="primary-button" bindtap="saveFoodRecord">保存记录 <text>✓</text></button></view>
      </view><view class="bottom-space"></view>
    </block>

    <block wx:if="{{activeTab == 'me'}}">
      <view wx:if="{{loading}}" class="empty-state"><text>正在加载数据…</text></view><view wx:elif="{{apiError}}" class="empty-state"><text>{{apiError}}</text><text class="section-link" bindtap="retryLoadData">点击重试</text></view><block wx:else>
      <view class="profile-head" bindtap="editNickname"><image wx:if="{{avatarPreview}}" class="avatar-large" src="{{avatarPreview}}" mode="aspectFill"></image><view wx:else class="avatar-large">等</view><view><text class="eyebrow">MY PAUSE LOG</text><text class="profile-name">{{form.authorName || '点击设置头像和昵称'}}</text><text class="profile-caption">坚持不是忍住所有，而是多想十秒。</text></view></view>
      <view class="stats-grid"><view class="stat-cell"><text class="stat-value">{{approvalRate}}%</text><text class="stat-label">通过率</text></view><view class="stat-cell"><text class="stat-value">{{savedCalories}}</text><text class="stat-label">累计省下 kcal</text></view><view class="stat-cell"><text class="stat-value">{{submittedCount}}</text><text class="stat-label">累计审批单</text></view></view>
      <view class="section-head personal-section"><view><text class="section-title">今日刹车线</text><text class="section-note">给身体留一点余地</text></view><text class="quota-label {{quotaExceeded ? 'over-text' : ''}}">{{todayCalories}} / {{quotaAvailable ? calorieQuota : '未设置'}}<text wx:if="{{quotaAvailable}}"> kcal</text></text></view>
      <view class="quota-card {{quotaExceeded ? 'quota-card-over' : ''}}"><view class="quota-bar"><view class="quota-bar-fill" style="width: {{quotaTrackPercent}}%;"></view></view><view class="quota-copy"><text>{{!quotaAvailable ? '尚未设置额度' : quotaExceeded ? '已超 ' + quotaExcess + ' kcal' : '还剩 ' + quotaRemaining + ' kcal'}}</text><text wx:if="{{topRejected}}">被驳回最多：{{topRejected}}</text></view></view>
      <view class="add-food-entry" bindtap="startRecord"><view><text class="add-food-title">今天还吃了什么？</text><text class="add-food-note">添加一条个人饮食记录，不需要审批</text></view><text class="add-food-mark">＋</text></view>
      <view class="section-head personal-section"><view><text class="section-title">最近记录</text><text class="section-note">每一次等等，都会留下答案</text></view></view>
      <view class="history-list"><block wx:for="{{myRecords}}" wx:key="id" wx:for-item="record"><view class="history-item"><view class="history-icon {{record.status == 'approved' ? 'green' : record.status == 'rejected' ? 'orange' : 'blue'}}">{{record.status == 'rejected' ? '×' : record.status == 'approved' ? '✓' : '…'}}</view><view class="history-main"><text>{{record.title}}</text><text>{{record.time}} · {{record.calorie}} kcal</text></view><view class="history-actions"><view wx:if="{{record.isApproval && record.status == 'approved' && !record.foodRecorded && !record.checkinResult}}" class="history-choice-actions"><button class="history-choice eaten-choice" data-id="{{record.id}}" bindtap="recordApprovalFood" loading="{{recordPrefillId == record.id}}" disabled="{{recordPrefillId != '' || recordActionId != ''}}"><text>吃了</text><text class="history-button-mark">✓</text></button><button class="history-choice skipped-choice" data-id="{{record.id}}" data-result="后悔" bindtap="checkIn" loading="{{recordActionId == record.id}}" disabled="{{recordPrefillId != '' || recordActionId != ''}}"><text>没吃</text><text class="history-button-mark">×</text></button></view><text wx:elif="{{record.isApproval && record.foodRecorded}}" class="history-result green-text">已记录</text><text wx:elif="{{record.isApproval && record.checkinResult}}" class="history-result green-text">{{record.checkinResult}}</text><text wx:elif="{{!record.isApproval}}" class="history-result green-text">已记录</text><text wx:else class="history-result {{record.status == 'rejected' ? 'orange-text' : 'blue-text'}}">{{record.statusLabel}}</text></view></view></block></view><view class="bottom-space"></view>
      </block>
    </block>
  </scroll-view>

  <view wx:if="{{activeTab == 'square' && barrageItems.length}}" class="barrage-wrap" catchtap="stopPropagation"><block wx:for="{{barrageItems}}" wx:key="renderKey" wx:for-item="item"><view class="barrage-bubble" style="background-color: {{item.background}}; color: {{item.textColor}}; animation-delay: {{item.delay}}s;"><text class="barrage-text">{{item.text}}</text></view></block></view>

  <view wx:if="{{keyboardHeight == 0}}" class="tabbar"><view class="tab-item {{activeTab == 'square' ? 'tab-active' : ''}}" data-tab="square" bindtap="switchTab"><text class="tab-icon">◎</text><text>广场</text></view><view class="create-tab" data-tab="apply" bindtap="switchTab" aria-role="button" aria-label="发起审批"><image class="create-icon" src="/assets/paw-stamp.png" mode="aspectFit" aria-hidden="true"></image><view class="create-shimmer" aria-hidden="true"><image class="paw-shimmer" src="/assets/paw-shimmer.png" mode="scaleToFill"></image></view><text>发起审批</text></view><view class="tab-item {{activeTab == 'me' ? 'tab-active' : ''}}" data-tab="me" bindtap="switchTab"><view class="tab-icon profile-icon"><view class="profile-head-icon"></view><view class="profile-body-icon"></view></view><text>我的</text></view></view>
  <view wx:if="{{shareSheetId}}" class="sheet-backdrop" catchtap="closeShareSheet"><view class="vote-sheet share-sheet" catchtap="stopPropagation"><view class="sheet-handle"></view><view class="sheet-heading"><view><text class="sheet-title">让判官来看看</text><text class="sheet-subtitle">分享申请，或生成一张干净的白底卡片</text></view><text class="sheet-close" bindtap="closeShareSheet">×</text></view><view class="share-options"><button class="share-option" open-type="share" data-id="{{shareSheetId}}">微信好友</button><button class="share-option" data-id="{{shareSheetId}}" bindtap="prepareTimelineShare">朋友圈</button><button class="share-option share-poster-option" bindtap="previewShareCard" loading="{{posterGenerating}}" disabled="{{posterGenerating}}">{{posterGenerating ? '正在生成…' : '生成白底分享图'}}</button></view><text class="share-watermark">干饭暂缓局｜嘴馋先审批</text></view></view>
  <canvas type="2d" id="approval-poster" class="poster-canvas" aria-hidden="true"></canvas>
  <view wx:if="{{nicknameAction}}" class="sheet-backdrop nickname-backdrop" style="padding-bottom: {{nicknameKeyboardHeight}}px;" catchtap="closeNicknameSheet">
    <form class="vote-sheet" catchtap="stopPropagation" bindsubmit="confirmNickname">
      <view class="sheet-handle"></view>
      <view class="sheet-heading"><view><text class="sheet-title">完善头像和昵称</text><text class="sheet-subtitle">用于在审批卡片中展示你的头像和昵称。</text></view><text class="sheet-close" bindtap="closeNicknameSheet">×</text></view>
      <view class="profile-fields">
        <view class="profile-field"><text class="profile-field-label">头像</text><button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{profileSaving}}"><image wx:if="{{avatarDraft}}" class="avatar-choice" src="{{avatarDraft}}" mode="aspectFill"></image><view wx:else class="avatar-choice avatar-placeholder">＋</view><text class="avatar-picker-hint">{{avatarDraft ? '更换头像' : '选择头像'}}</text><text class="profile-field-arrow">›</text></button></view>
        <view class="profile-field"><text class="profile-field-label">昵称</text><input class="nickname-input" name="authorName" type="nickname" value="{{nicknameInitialValue}}" disabled="{{profileSaving}}" bindkeyboardheightchange="onNicknameKeyboardHeightChange" bindnicknamereview="onNicknameReview" adjust-position="false" placeholder="点击使用微信昵称" maxlength="32" /></view>
      </view>
      <button class="primary-button sheet-button" form-type="submit" loading="{{profileSaving}}" disabled="{{profileSaving}}">{{profileSaving ? '正在保存' : '保存并继续'}} <text wx:if="{{!profileSaving}}">→</text></button>
    </form>
  </view>
  <view wx:if="{{voteTargetId}}" class="sheet-backdrop" catchtap="closeVoteSheet"><view class="vote-sheet" catchtap="stopPropagation"><view class="sheet-handle"></view><view class="sheet-heading"><view><text class="sheet-title">{{voteChoice == 'approve' ? '你觉得可以吃吗？' : '你想让这顿等等？'}}</text><text class="sheet-subtitle">说说理由，这张票才会被大家看见。</text></view><text class="sheet-close" bindtap="closeVoteSheet">×</text></view><textarea class="vote-textarea" value="{{voteReason}}" bindinput="onVoteReasonInput" placeholder="比如：今天运动量够，偶尔吃一次没关系。" maxlength="80" auto-height="true"></textarea><button class="primary-button sheet-button" bindtap="submitVote">提交这张票 <text>→</text></button></view></view>
</view>
