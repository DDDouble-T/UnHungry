# CloudBase 环境 ID；留空时使用本地内存仓储
TCB_ENV_ID=your-env-id
# 生产首选 MySQL；留空时使用 CloudBase 数据库实现。
DB_DRIVER=mysql
MYSQL_HOST=your-mysql-host
# 云托管 MySQL 若提供 MYSQL_ADDRESS=host:port，可使用它替代 MYSQL_HOST/MYSQL_PORT。
MYSQL_ADDRESS=
MYSQL_PORT=3306
MYSQL_DATABASE=unhungry
MYSQL_USER=your-mysql-user
# 云托管 MySQL 若提供 MYSQL_USERNAME，可使用它替代 MYSQL_USER。
MYSQL_USERNAME=
MYSQL_PASSWORD=your-mysql-password
MYSQL_CONNECTION_LIMIT=5
PORT=3000
NODE_ENV=production
# 生产环境建议开启。CloudBase 网关会注入 x-wx-openid。
REQUIRE_OPENID=true
# 本地联调可设为 1，忽略 TCB_ENV_ID
USE_MEMORY_DB=0
# 微信小程序订阅消息配置；模板字段名需与公众平台模板一致。
WECHAT_APP_ID=your-miniprogram-app-id
WECHAT_APP_SECRET=your-miniprogram-app-secret
WECHAT_SUBSCRIBE_TEMPLATE_ID=your-template-id
WECHAT_SUBSCRIBE_PAGE=pages/index/index
WECHAT_SUBSCRIBE_TITLE_FIELD=thing1
WECHAT_SUBSCRIBE_STATUS_FIELD=phrase2
WECHAT_SUBSCRIBE_DETAIL_FIELD=thing3
